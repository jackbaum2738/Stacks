DATABASE_URL="postgresql://user:password@localhost:5432/stacks"
# Only needed in production behind a connection pooler (e.g. Neon's pooled
# connection). Prisma Migrate needs a direct, unpooled connection; the app's
# normal queries use DATABASE_URL and can go through the pooler. Locally,
# just set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/stacks"
AUTH_SECRET="generate-a-long-random-string-for-production"
# Brevo transactional email API key (Brevo dashboard -> SMTP & API -> API Keys). Without this
# set, password-reset emails are skipped and logged rather than sent -- fine for local dev.
BREVO_API_KEY=""
