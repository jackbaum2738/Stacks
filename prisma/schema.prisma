generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEW_ONLY
}

enum CopyStatus {
  AVAILABLE
  RESERVED
  REMOVED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String               @unique
  passwordHash        String
  name                String?
  createdAt           DateTime             @default(now())
  memberships         Membership[]
  reservations        Reservation[]        @relation("ReservationCreatedBy")
  backupsTaken        Library[]            @relation("LibraryLastBackupBy")
  passwordResetTokens PasswordResetToken[]
  invitesSent         LibraryInvite[]      @relation("LibraryInviteSentBy")
}

/// A one-time, short-lived token emailed to a user who requested a password reset. Stores
/// only a hash of the token (never the raw value) so a database leak alone can't be replayed
/// into an account takeover. `usedAt` marks a spent token without deleting it -- there's no
/// unique constraint here that a leftover used row could ever block, unlike the Reservation
/// bug (see CLAUDE.md) -- and forgot-password always deletes any other outstanding unused
/// tokens for the user first, so only the most recently requested link is ever live.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A single household/network member's library of physical books.
model Library {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  createdAt          DateTime       @default(now())
  lastBackupAt       DateTime?
  lastBackupByUserId String?
  memberships        Membership[]
  shelves            Shelf[]
  copies             Copy[]
  bookOverrides      BookOverride[]
  people             Person[]
  invites            LibraryInvite[]
  bookLookupLogs     BookLookupLog[]
  lastBackupBy       User?          @relation("LibraryLastBackupBy", fields: [lastBackupByUserId], references: [id], onDelete: SetNull)
}

/// A pending emailed invite to join a library at a specific role (never OWNER -- transfer is
/// the only way to become Owner). Replaces the old per-role invite-link columns: instead of a
/// generic link anyone could use, an Admin enters a specific email and Stacks sends it a
/// one-time acceptance link (see src/lib/emails/library-invite.ts). A row's mere existence
/// *is* "open" -- Cancel and a successful Accept both delete it outright (no cancelledAt/
/// acceptedAt flag) so the Open Invitations tab is just "every row here", same delete-not-flag
/// pattern used for Reservation release (see CLAUDE.md's Bugs Found section) -- there's no
/// unique constraint here a leftover row could ever block, but there's also no reason to keep
/// a dead row around once it's resolved. `lastSentAt` gates the 60s resend cooldown.
model LibraryInvite {
  id           String   @id @default(cuid())
  libraryId    String
  email        String
  role         Role
  token        String   @unique
  invitedById  String?
  createdAt    DateTime @default(now())
  lastSentAt   DateTime @default(now())
  library      Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  invitedBy    User?    @relation("LibraryInviteSentBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([libraryId, email])
  @@index([libraryId])
}

/// Links a user to a library with a role, so a library can eventually be shared/co-managed.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  libraryId String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([userId, libraryId])
}

model Shelf {
  id        String   @id @default(cuid())
  libraryId String
  name      String
  code      String?
  createdAt DateTime @default(now())
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  copies    Copy[]

  @@unique([libraryId, name])
}

/// Catalog metadata for a title, shared across every library so a lookup is only ever done once.
/// This is the trusted, ISBN-lookup-sourced record — never edited directly by users (see
/// BookOverride) so one library's bad correction can't corrupt what every other library sees.
model Book {
  id                   String         @id @default(cuid())
  isbn13               String         @unique
  isbn10               String?
  title                String
  authors              String[]
  publisher            String?
  publishedDate        String?
  pageCount            Int?
  description          String?
  coverUrl             String?
  source               String?
  createdAt            DateTime       @default(now())
  /// How many times someone has clicked "look up this ISBN" on the edit page while this
  /// book was still unresolved. Capped at 1 in application code to stop the button being
  /// spammed on a book that genuinely isn't in either catalog -- distinct from (and doesn't
  /// limit) the automatic retry scan-in already does every time an unresolved ISBN is
  /// scanned in, since that only ever fires once per real scan.
  manualLookupAttempts Int            @default(0)
  copies               Copy[]
  overrides            BookOverride[]
}

/// A library's local corrections to a Book's shared catalog metadata, invisible to every
/// other library. Null fields (and an empty `authors`) mean "not corrected here" and fall
/// back to the canonical Book fields — see src/lib/book-view.ts.
model BookOverride {
  id          String   @id @default(cuid())
  bookId      String
  libraryId   String
  title       String?
  authors     String[]
  publisher   String?
  pageCount   Int?
  description String?
  coverUrl    String?
  updatedAt   DateTime @updatedAt
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([bookId, libraryId])
}

/// One physical copy of a Book sitting in a specific Library (and Shelf). BookCrossing IDs
/// live here rather than on Book: a BCID identifies one released physical copy, not a
/// title/edition, so two copies of the same ISBN (even within one library) can have
/// different BCIDs.
model Copy {
  id             String       @id @default(cuid())
  libraryId      String
  bookId         String
  shelfId        String?
  status         CopyStatus   @default(AVAILABLE)
  /// A short, human-friendly identifier shown in place of `id` on the CSV export/import
  /// ("C-7F3K9Q") -- random rather than sequential per the user's explicit choice, and
  /// only unique per-library (see src/lib/copy-code.ts), since nothing ever compares codes
  /// across libraries.
  code           String
  addedAt        DateTime     @default(now())
  removedAt      DateTime?
  notes          String?
  bookCrossingId String?
  library        Library      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  book           Book         @relation(fields: [bookId], references: [id])
  shelf          Shelf?       @relation(fields: [shelfId], references: [id])
  reservation    Reservation?

  @@unique([libraryId, code])
  @@index([libraryId, status])
  @@index([bookId])
}

/// Holds a copy for a specific person until enough books have piled up to make sending worthwhile.
model Reservation {
  id          String    @id @default(cuid())
  copyId      String    @unique
  personId    String?
  note        String?
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  createdById String?
  copy        Copy      @relation(fields: [copyId], references: [id], onDelete: Cascade)
  person      Person?   @relation(fields: [personId], references: [id])
  createdBy   User?     @relation("ReservationCreatedBy", fields: [createdById], references: [id])
}

/// One attempt to resolve an ISBN against the external book catalogs (Google Books, Open
/// Library), written by scan-in and the manual "look up this ISBN" button -- never by CSV
/// import, which deliberately never calls either API (see CLAUDE.md). Exists so a real
/// failure (a provider timing out, returning an error, or genuinely not having the ISBN) can
/// be diagnosed after the fact without relying on Vercel's own function logs, which only
/// retain briefly on the Hobby plan and aren't queryable by ISBN. Jack reads this directly in
/// Neon -- there's deliberately no in-app viewer for it, since he asked to just read the table
/// himself rather than have one built.
model BookLookupLog {
  id                 String   @id @default(cuid())
  libraryId          String
  isbn13             String
  /// "scan-in" (new ISBN) | "scan-in-retry" (re-resolving a manual-unresolved book on a
  /// later scan) | "manual-button" (the edit page's "look up this ISBN" button).
  triggeredBy        String
  googleBooksCalled  Boolean
  /// "success" | "no-match" | "http-error" | "network-error"
  googleBooksOutcome String
  googleBooksDetail  String?
  openLibraryCalled  Boolean
  /// Same outcome values as googleBooksOutcome, or null when openLibraryCalled is false
  /// (Google Books alone already had everything, so Open Library was never called).
  openLibraryOutcome String?
  openLibraryDetail  String?
  /// Whether this attempt ended with a usable title, regardless of which provider supplied it.
  resolved           Boolean
  createdAt          DateTime @default(now())
  library            Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, createdAt])
}

/// Someone books get reserved for, in a library-scoped directory (PR: People tab). Only
/// `name` is required -- email is the sole field that must be unique per library (and can
/// still be left blank, since a nullable column's NULLs never collide with each other in
/// Postgres), so unlike email, duplicate names are fully expected (two people can share a
/// name) and never merged automatically.
model Person {
  id           String        @id @default(cuid())
  libraryId    String
  name         String
  email        String?
  phone        String?
  location     String?
  birthday     DateTime?
  /// Short "P-XXXXXX" identifier for CSV export/import round-tripping, same idea as
  /// Copy.code -- see src/lib/person-code.ts. Needed because names alone can't be trusted
  /// to match a row back to the right person once duplicates are allowed.
  code         String
  createdAt    DateTime      @default(now())
  library      Library       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([libraryId, code])
  @@unique([libraryId, email])
  @@index([libraryId])
}
