generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum CopyStatus {
  AVAILABLE
  RESERVED
  REMOVED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  reservations Reservation[] @relation("ReservationCreatedBy")
  backupsTaken Library[]     @relation("LibraryLastBackupBy")
}

/// A single household/network member's library of physical books.
model Library {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  inviteCode         String?        @unique
  createdAt          DateTime       @default(now())
  lastBackupAt       DateTime?
  lastBackupByUserId String?
  memberships        Membership[]
  shelves            Shelf[]
  copies             Copy[]
  bookOverrides      BookOverride[]
  lastBackupBy       User?          @relation("LibraryLastBackupBy", fields: [lastBackupByUserId], references: [id], onDelete: SetNull)
}

/// Links a user to a library with a role, so a library can eventually be shared/co-managed.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  libraryId String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([userId, libraryId])
}

model Shelf {
  id        String   @id @default(cuid())
  libraryId String
  name      String
  code      String?
  createdAt DateTime @default(now())
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  copies    Copy[]

  @@unique([libraryId, name])
}

/// Catalog metadata for a title, shared across every library so a lookup is only ever done once.
/// This is the trusted, ISBN-lookup-sourced record — never edited directly by users (see
/// BookOverride) so one library's bad correction can't corrupt what every other library sees.
model Book {
  id                   String         @id @default(cuid())
  isbn13               String         @unique
  isbn10               String?
  title                String
  authors              String[]
  publisher            String?
  publishedDate        String?
  pageCount            Int?
  description          String?
  coverUrl             String?
  source               String?
  createdAt            DateTime       @default(now())
  /// How many times someone has clicked "look up this ISBN" on the edit page while this
  /// book was still unresolved. Capped at 1 in application code to stop the button being
  /// spammed on a book that genuinely isn't in either catalog -- distinct from (and doesn't
  /// limit) the automatic retry scan-in already does every time an unresolved ISBN is
  /// scanned in, since that only ever fires once per real scan.
  manualLookupAttempts Int            @default(0)
  copies               Copy[]
  overrides            BookOverride[]
}

/// A library's local corrections to a Book's shared catalog metadata, invisible to every
/// other library. Null fields (and an empty `authors`) mean "not corrected here" and fall
/// back to the canonical Book fields — see src/lib/book-view.ts.
model BookOverride {
  id          String   @id @default(cuid())
  bookId      String
  libraryId   String
  title       String?
  authors     String[]
  publisher   String?
  pageCount   Int?
  description String?
  coverUrl    String?
  updatedAt   DateTime @updatedAt
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([bookId, libraryId])
}

/// One physical copy of a Book sitting in a specific Library (and Shelf). BookCrossing IDs
/// live here rather than on Book: a BCID identifies one released physical copy, not a
/// title/edition, so two copies of the same ISBN (even within one library) can have
/// different BCIDs.
model Copy {
  id             String       @id @default(cuid())
  libraryId      String
  bookId         String
  shelfId        String?
  status         CopyStatus   @default(AVAILABLE)
  /// A short, human-friendly identifier shown in place of `id` on the CSV export/import
  /// ("C-7F3K9Q") -- random rather than sequential per the user's explicit choice, and
  /// only unique per-library (see src/lib/copy-code.ts), since nothing ever compares codes
  /// across libraries.
  code           String
  addedAt        DateTime     @default(now())
  removedAt      DateTime?
  notes          String?
  bookCrossingId String?
  library        Library      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  book           Book         @relation(fields: [bookId], references: [id])
  shelf          Shelf?       @relation(fields: [shelfId], references: [id])
  reservation    Reservation?

  @@unique([libraryId, code])
  @@index([libraryId, status])
  @@index([bookId])
}

/// Holds a copy for a specific person until enough books have piled up to make sending worthwhile.
model Reservation {
  id          String    @id @default(cuid())
  copyId      String    @unique
  reservedFor String
  contact     String?
  note        String?
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  createdById String?
  copy        Copy      @relation(fields: [copyId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ReservationCreatedBy", fields: [createdById], references: [id])
}
